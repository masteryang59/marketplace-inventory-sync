# --- Sync service ---
PORT=3000
LOG_LEVEL=info                 # debug also logs every successful HTTP request
SYNC_INTERVAL_SECONDS=10       # 0 = only sync from the dashboard / POST /api/sync
INITIAL_STRATEGY=min           # first sync of a SKU: min | ebay | shopify
DRY_RUN=false                  # plan and log changes without writing them
STATE_FILE=data/state.json
DEMO_CONTROLS=true             # "Sell 1" buttons on the dashboard (mock APIs only)

# --- HTTP retries ---
REQUEST_TIMEOUT_MS=5000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=250
RETRY_MAX_MS=8000

# --- Marketplaces (defaults point at the mocks) ---
EBAY_BASE_URL=http://localhost:4001
EBAY_TOKEN=mock-ebay-token
SHOPIFY_BASE_URL=http://localhost:4002
SHOPIFY_TOKEN=shpat_mock_token
SHOPIFY_API_VERSION=2024-10
SHOPIFY_LOCATION_ID=1001

# --- Mock marketplaces: share of requests that fail ---
MOCK_RATE_LIMIT_RATE=0.05      # 429 Too Many Requests
MOCK_FAILURE_RATE=0.05         # 503 Service Unavailable
MOCK_LATENCY_MS=40
BATCH_INSERT=enabled
RESIZE_IMAGE=enabled
CHECK_HEALTH=enabled
BATCH_INSERT=enabled
COMPACT_STORAGE=enabled